    {
      "parameters": {
        "jsCode": "// Diary is empty (weekly rotation happened) -> use the latest part of the user profile as context\nconst profile = ($('Get Aura_user_profile').first().json.content ?? '').toString();\nconst marker = '--- Weekly Summary';\nconst idx = profile.lastIndexOf(marker);\nlet tail = idx >= 0 ? profile.slice(idx) : profile.slice(-4000);\nif (tail.length > 24000) {\n  tail = tail.slice(-24000);\n}\nconst header = 'Diary is empty (weekly rotation happened). Context from the latest part of the user profile:\\n\\n';\nreturn [{ json: { content: header + tail.trim() } }];"
      },
